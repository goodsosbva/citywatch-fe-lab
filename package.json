{
    "name": "city-watch-fe-lab",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "npm --workspace @citywatch/web run dev",
        "dev:remote": "npm --workspace @citywatch/analytics-remote run dev",
        "dev:realtime": "npm --workspace @citywatch/realtime-server run dev",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "eslint apps packages scripts --max-warnings=0",
        "typecheck": "npm run typecheck --workspaces --if-present"
    },
    "engines": {
        "node": ">=20"
    },
    "overrides": {
        "adm-zip": "$adm-zip",
        "postcss": "^8.5.26"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@storybook/react-vite": "^10.5.2",
        "adm-zip": "0.6.0",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "postcss": "^8.5.26",
        "storybook": "^10.5.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    }
}
